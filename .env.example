# ─────────────────────────────────────────────────────────────────────────────
# Switchyard configuration
# Copy this file to ".env" and adjust the values. Never commit ".env".
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express server (API + built client) listens on.
PORT=8080
# "development" or "production". In production the session cookie is sent
# Secure-only (HTTPS), so run Switchyard behind TLS.
NODE_ENV=development
# Secret used to sign the session cookie. Use a long, random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Send the session cookie over HTTPS only. Set to true when Switchyard runs
# behind a TLS reverse proxy; false for plain-HTTP access (e.g. local Docker).
SECURE_COOKIES=false

# ── Traefik dynamic config file ──────────────────────────────────────────────
# Path to the Traefik dynamic configuration file Switchyard reads and writes.
# Traefik watches this file and hot-reloads when it changes.
# Example for a real deployment:  /etc/traefik/dynamic.yml
TRAEFIK_DYNAMIC_FILE=./data/dynamic.yml

# ── Password login ───────────────────────────────────────────────────────────
# Credentials for the username/password sign-in form.
# Leave ADMIN_PASSWORD empty to disable password login entirely.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── OpenID Connect / SSO (Authentik) ─────────────────────────────────────────
# SSO sign-in is STUBBED in this build: these variables are read and the SSO
# button is shown, but the OIDC redirect/callback flow is not yet implemented.
# Set SSO_ENABLED=true once the flow in server/routes/auth.js is completed.
SSO_ENABLED=false
# Display name shown on the SSO button ("Continue with <name>").
OIDC_PROVIDER_NAME=Authentik
# Authentik OIDC application issuer / discovery URL.
OIDC_ISSUER_URL=https://sso.example.com/application/o/switchyard/
# OAuth2 client credentials from the Authentik provider.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Callback URL registered with the provider — must match exactly.
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/sso/callback
# Space-separated OIDC scopes to request.
OIDC_SCOPES=openid profile email

# ── Service health checks ────────────────────────────────────────────────────
# How often (milliseconds) Switchyard re-checks every service's upstream
# servers in the background.
HEALTH_CHECK_INTERVAL=30000
# Per-request timeout (milliseconds) before an upstream is marked unreachable.
HEALTH_CHECK_TIMEOUT=5000

# ── Docker deployment (docker-compose.yml only) ──────────────────────────────
# Host directory bind-mounted into the container at /data. Point it at the
# directory that contains your real Traefik dynamic config file (e.g.
# /etc/traefik). Inside the container, TRAEFIK_DYNAMIC_FILE is set to
# /data/dynamic.yml.
TRAEFIK_DYNAMIC_DIR=./data

# ── Traefik reverse-proxy integration (docker-compose.yml) ───────────────────
# Set TRAEFIK_ENABLE=true to register the container with Traefik through Docker
# labels and attach it to the shared Traefik network. The values below are
# injected into the deployment from this file — the compose file needs no edits.
# Leave it false to run standalone (Traefik ignores the container).
# When exposing Switchyard over HTTPS through Traefik, also set SECURE_COOKIES=true.
TRAEFIK_ENABLE=false
# Docker network shared with your Traefik instance. With TRAEFIK_ENABLE=true it
# must already exist; with =false, Compose creates a local network of this name
# (pick a name nothing else already uses).
TRAEFIK_NETWORK=traefik-public
# Hostname Traefik routes to Switchyard — the Host(`…`) router rule.
SWITCHYARD_HOST=switchyard.example.com
# Traefik entrypoint(s) the router listens on (comma-separated, e.g. websecure).
TRAEFIK_ENTRYPOINTS=websecure
# Traefik certificatesResolver name for the TLS certificate (empty for none).
TRAEFIK_CERTRESOLVER=cloudflare
