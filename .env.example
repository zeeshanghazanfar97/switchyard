# ─────────────────────────────────────────────────────────────────────────────
# Switchyard configuration
# Copy this file to ".env" and adjust the values. Never commit ".env".
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express server (API + built client) listens on.
PORT=8080
# "development" or "production". In production the session cookie is sent
# Secure-only (HTTPS), so run Switchyard behind TLS.
NODE_ENV=development
# Secret used to sign the session cookie. Use a long, random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Traefik dynamic config file ──────────────────────────────────────────────
# Path to the Traefik dynamic configuration file Switchyard reads and writes.
# Traefik watches this file and hot-reloads when it changes.
# Example for a real deployment:  /etc/traefik/dynamic.yml
TRAEFIK_DYNAMIC_FILE=./data/dynamic.yml

# ── Password login ───────────────────────────────────────────────────────────
# Credentials for the username/password sign-in form.
# Leave ADMIN_PASSWORD empty to disable password login entirely.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── OpenID Connect / SSO (Authentik) ─────────────────────────────────────────
# SSO sign-in is STUBBED in this build: these variables are read and the SSO
# button is shown, but the OIDC redirect/callback flow is not yet implemented.
# Set SSO_ENABLED=true once the flow in server/routes/auth.js is completed.
SSO_ENABLED=false
# Display name shown on the SSO button ("Continue with <name>").
OIDC_PROVIDER_NAME=Authentik
# Authentik OIDC application issuer / discovery URL.
OIDC_ISSUER_URL=https://sso.example.com/application/o/switchyard/
# OAuth2 client credentials from the Authentik provider.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Callback URL registered with the provider — must match exactly.
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/sso/callback
# Space-separated OIDC scopes to request.
OIDC_SCOPES=openid profile email

# ── Service health checks ────────────────────────────────────────────────────
# How often (milliseconds) Switchyard re-checks every service's upstream
# servers in the background.
HEALTH_CHECK_INTERVAL=30000
# Per-request timeout (milliseconds) before an upstream is marked unreachable.
HEALTH_CHECK_TIMEOUT=5000
